rules_version = '2';
// Indonesia 2026 · solo Dani y Augusto (logueados) pueden leer y escribir.
// Pegar en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['danii.nasif@gmail.com', 'augustotraghetti@gmail.com'];
    }
  }
}
